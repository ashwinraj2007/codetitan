# ==========================================
# ORIGINALITY AI DETECTOR - ENVIRONMENT VARIABLES
# ==========================================

# 1. NextAuth / Authentication
# Generate a secret: `openssl rand -base64 32` or use any 32-character string
NEXTAUTH_SECRET=your_nextauth_32_char_secret_key_here
NEXTAUTH_URL=http://localhost:3000
# When deployed to Vercel, set NEXTAUTH_URL to your Vercel deployment URL (e.g. https://your-app.vercel.app)

# 2. Email Verification Code Settings (Send code to Gmail / Email)
# To send real emails via Gmail SMTP, generate a Google "App Password":
# Go to https://myaccount.google.com/apppasswords (requires 2-Step Verification turned on)
# Create an App Password named "Originality AI" and paste here:
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Or use custom SMTP provider (SendGrid, Mailgun, Brevo, AWS SES):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Note: If GMAIL_USER/GMAIL_APP_PASSWORD are left empty, OriginalityAI automatically operates 
# in "Demo Simulation Mode" — displaying the 6-digit code directly in the terminal and on the screen
# so you and your students can test and evaluate without configuring an email server!

# 3. AI Detection Engine (Google Gemini - FREE TIER)
# Free API key with 15 requests/minute & 1,500 requests/day, no credit card required
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
